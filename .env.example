# ---- Client-side (shipped in the app bundle; these are public identifiers, not secrets) ----
# Spotify Developer Dashboard -> your app -> Client ID. Uses Authorization Code + PKCE, no secret needed.
VITE_SPOTIFY_CLIENT_ID=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
VITE_GOOGLE_CLIENT_ID=
# Must exactly match the redirect URIs registered in both dashboards.
# Web dev: http://127.0.0.1:5173/   Native (Capacitor): com.adityakamat.dhh://callback
VITE_REDIRECT_URI=http://127.0.0.1:5173/

# ---- Chart builder only (scripts/build-charts.ts, GitHub Action secrets). Never prefix with VITE_. ----
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
